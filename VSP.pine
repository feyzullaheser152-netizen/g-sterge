//@version=6
// Vadeli Scalp Pusulasi (VSP) - v6.4.0 | 1 dakika piyasa gostergesi
// Kullanicinin istegiyle AL/SAT, stop, hedef ve pozisyon buyuklugu onerisi geri geldi (v6.0). Grafikte tablo ya da kutu yoktur. Bilgi dort yoldan verilir:
//   1) AL/SAT etiketi (mum kapanisinda): dipten al, tepeden sat. Sert 15 dk dususten sonra AL, sert 15 dk yukselisten sonra SAT (geri donus). Stop ve hedef cizgileri, etikette miktar.
//      Dayanak: arastirmada tutarli cikan tek yon etkisi (BULGULAR 3, 10c, 14). v6.1: kullanici komisyonu onemsemiyor; ayarlar komisyonsuz (brut) 2025 sonucuyla secildi:
//      piyasa girisi, stop 2 sigma15, hedef 2R, en fazla 5 dk. Brut islem basina 2025 / 2026: AL +3,8 / +1,4 bp, SAT -0,3 / -0,4 bp (BULGULAR 14b).
//      Ayni motorla sinanan 13 topluluk gostergesinin (Supertrend, UT Bot, MACD, WaveTrend, Squeeze vb.) hicbiri daha iyi degil (BULGULAR 14).
//   2) Durum satiri (gosterge adinin yaninda): hareket / maliyet, beklenen hareket (%50 ve %80), siradaki oynaklik anina kalan dakika.
//   3) Arka plan: mor = olagandisi oynaklik (zamanlanmis olay, asiri mumdan sonraki 4 mum, iki yonde sert akis);
//      kirmizi = FOMC aciklamasinin ilk dakikalari ve CPI / Istihdam Raporu (NFP) gunlerinde 08:30 ET mumu;
//      turuncu = sert satis akisinin hemen ardindaki mum (bu mumda SHORT kovalamak ortalamada dezavantajli).
//   4) Cizgiler ve isaretler: SMA20 (yonune gore yesil/kirmizi), uyumsuzluk ucgenleri (10 gostergede normal uyumsuzluk), trend cizgileri ve kirilim oklari,
//      VWAP ve +-2 sigma bantlari,
//      onceki gun yuksek/dusuk, Asya seansi yuksek/dusuk. Seviye cizgileri yalnizca bilgi icindir; testlerde rastgele seviyelerden daha iyi tutmadi.
// Dayanak: 22 Binance vadeli paritesi, 21 ay (arastirma/BULGULAR.md, bolum 10-17).
indicator("Vadeli Scalp Pusulası", shorttitle = "VSP", overlay = true, max_labels_count = 500, max_bars_back = 1000)

// === Girdiler ===
grpS = "AL/SAT, stop ve pozisyon"
showSig  = input.bool(true, "AL/SAT sinyalleri", group = grpS, display = display.none)
balance  = input.float(1000, "Hesap bakiyesi (USDT)", minval = 1, group = grpS, display = display.none)
riskPct  = input.float(0.5, "İşlem başına risk % (stopta kaybedilecek tutar)", minval = 0.05, maxval = 5, step = 0.05, group = grpS, display = display.none)
stopK    = input.float(2.0, "Stop mesafesi (15 dk oynaklığın katı)", minval = 0.5, maxval = 5, step = 0.25, group = grpS, display = display.none)
tpR      = input.float(2.0, "Hedef (stop mesafesinin katı, R)", minval = 0.5, maxval = 5, step = 0.25, group = grpS, display = display.none)
holdMax  = input.int(5, "En uzun tutma (dk); sonra kapanışta çık", minval = 1, maxval = 240, group = grpS, display = display.none)

grpE = "Maliyet"
entryMode = input.string("Piyasa (taker)", "Giriş emri tipiniz", options = ["Limit (maker)", "Piyasa (taker)"], group = grpE, display = display.none)
makerFee  = input.float(0.02, "Maker komisyonu % (tek yön)", step = 0.005, group = grpE, display = display.none)
takerFee  = input.float(0.05, "Taker komisyonu % (tek yön)", step = 0.005, group = grpE, display = display.none)
slipSide  = input.float(0.01, "Kayma % (tek yön; en az yarım tick)", step = 0.005, group = grpE, display = display.none)

grpP = "Piyasa koşulu"
horizon   = input.int(15, "Beklenen hareket ufku (dk)", minval = 1, maxval = 240, group = grpP, display = display.none)
spikeAtr  = input.float(4.0, "Aşırı mum sınırı (ATR x)", step = 0.5, group = grpP, display = display.none)
spikeWait = input.int(4, "Aşırı mumdan sonra uyarı süresi (mum)", minval = 1, group = grpP, display = display.none)
flowZ     = input.float(3.0, "Sert hareket eşiği (15 dk z)", step = 0.5, group = grpP, display = display.none)
flowImb   = input.float(0.15, "Akış dengesizliği eşiği", step = 0.05, group = grpP, display = display.none)

grpV = "Görünüm"
showLevels = input.bool(true, "VWAP ve günlük seviyeler", group = grpV, display = display.none)
showVolBg  = input.bool(true, "Olağandışı oynaklıkta arka plan", group = grpV, display = display.none)
showFlowBg = input.bool(true, "Sert satış akışından sonra arka plan", group = grpV, display = display.none)
showSma    = input.bool(true, "SMA20 (yönüne göre renk)", group = grpV, display = display.none)
showDiv    = input.bool(true, "Uyumsuzluk işaretleri (10 gösterge)", group = grpV, display = display.none)
showTl     = input.bool(true, "Trend çizgileri ve kırılım okları", group = grpV, display = display.none)

// Karanlik mod icin acik renkler
cVwap   = #FFD54F
cBand   = #FFE57F
cDay    = #EEEEEE
cAsia   = #EA80FC
cGood   = #B9F6CA
cWarn   = #FFFF8D
cBad    = #FF8A80
cInfo   = #E0E0E0
cEvent  = #EA80FC
cVolBg  = color.new(#EA80FC, 82)
cRedBg  = color.new(#FF8A80, 72)
cFlowBg = color.new(#FFD180, 72)
cBuy    = #69F0AE
cSell   = #FF5252

if timeframe.period != "1"
    runtime.error("VSP yalnızca 1 dakikalık grafik için kalibre edildi. Grafiği 1 dakikaya alın.")

isLimit = entryMode == "Limit (maker)"

// === Hesaplar ===
atr = ta.atr(14)
newDay = timeframe.change("D")
[vwapV, vwapU, vwapL] = ta.vwap(hlc3, newDay, 2.0)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)

// Asya seansi (00-08 UTC) yuksek/dusuk, 08:00'den sonra cizilir
inAsia = not na(time(timeframe.period, "0000-0800", "UTC"))
asiaStart = inAsia and not inAsia[1]
var float asiaHT = na
var float asiaLT = na
if asiaStart
    asiaHT := high
    asiaLT := low
else if inAsia
    asiaHT := math.max(nz(asiaHT, high), high)
    asiaLT := math.min(nz(asiaLT, low), low)
asiaHi = not inAsia ? asiaHT : na
asiaLo = not inAsia ? asiaLT : na

// Beklenen hareket: 1 dk getirinin 30 mumluk EWMA varyansi (22 paritede kalibre; %50 dilim 0.61, %80 dilim 1.23; 1-240 dk ufukta sapma < %10)
r1    = math.log(close / close[1])
ewVar = ta.ema(nz(r1 * r1), 30)
sigH  = math.sqrt(ewVar * horizon)
em50  = 0.61 * sigH
em80  = 1.23 * sigH

// Hareket / maliyet: ufuktaki tipik hareket (%50 dilim), gidis-donus maliyetinin kac kati
// Kayma en az yarim tick: makas 1 tick'in altina inemez (Mart 2024 gercek kotasyon: zamanin %92-100'unde tam 1 tick). Kaba tickli ucuz coinlerde yarim tick 2-4 bp olabilir.
slipEff  = math.max(slipSide, 50 * syminfo.mintick / close)
takerX   = takerFee + slipEff
entryX   = isLimit ? makerFee : takerX
costPct  = entryX + takerX
moveCost = costPct > 0 ? em50 * 100 / costPct : na

// Akis: BVC tahmini delta ve 15 dk hareketin z-skoru. Uyarilar yalnizca kapanmis mumlardan uretilir (repaint yok).
dp      = close - close[1]
dpSd    = ta.stdev(dp, 100)
buyFrac = dpSd > 0 ? 1.0 / (1.0 + math.exp(-1.702 * dp / dpSd)) : 0.5
sVol    = volume * (2 * buyFrac - 1)
v15     = math.sum(volume, 15)
imb15   = v15 > 0 ? math.sum(sVol, 15) / v15 : 0.0
sd1     = ta.stdev(r1, 1440)
z15     = sd1 > 0 ? math.log(close / close[15]) / (sd1 * math.sqrt(15)) : 0.0
flowUp  = z15 >= flowZ and imb15 >= flowImb
flowDn  = z15 <= -flowZ and imb15 <= -flowImb
// barssince her mumda hesaplanmali (and kisa devre yapar), bu yuzden ayri satirlarda
dnAgo = nz(ta.barssince(flowDn[1]), 9999)
upAgo = nz(ta.barssince(flowUp[1]), 9999)
// Yeni sert satis: onceki 15 mumda sert satis yok. Uyari yalnizca bir sonraki mumda (veri: etki yalnizca ilk mumda ve yalnizca satis tarafinda)
newDn      = flowDn and dnAgo >= 15
chaseShort = newDn[1]
// Iki yonde sert akis: son 15 kapanmis mumda hem sert alis hem sert satis (oynaklik normalin ~2,1 kati)
twoWay = upAgo < 15 and dnAgo < 15

// Asiri mum: mum boyu > 4 ATR; sonraki 4 mumda oynaklik iki yilda da normalin >= 1,5 kati (5. mumda 1,498)
spike    = (high - low) > spikeAtr * nz(atr[1], atr)
spikeAgo = nz(ta.barssince(spike[1]), 9999)
spikeAct = spikeAgo < spikeWait

// Zamanlanmis oynaklik anlari (New York saati; ABD yaz/kis saati otomatik). dayofweek: 1 = Pazar ... 7 = Cumartesi
// Pencereler veriyle belirlendi: olay dakikasindan baslayip oynakligin iki yilda da normalin >= 1,5 kati kaldigi dakikalar.
// FOMC (14 toplanti): 14:00-14:05 blok ortalamasi ~3,9 kat (kirmizi), 13:59-14:44 blok ortalamasi ~2,4-2,6 kat (mor).
NY = "America/New_York"
// Listeler 2028 sonuna kadar gecerli. FOMC 2028 icin yalnizca Ocak toplantisi aciklandi (gecici); Fed takvimi yayimlaninca guncelleyin.
// nyHol: NYSE tatilleri (09:30 acilisi yok). dataHol: federal tatiller (08:30 / 10:00 ABD verisi yok; Kutsal Cuma'da veri olabilir).
var array<int> nyHol = array.from(20261126, 20261225, 20270101, 20270118, 20270215, 20270326, 20270531, 20270618, 20270705, 20270906, 20271125, 20271224, 20280117, 20280221, 20280414, 20280529, 20280619, 20280704, 20280904, 20281123, 20281225)
var array<int> dataHol = array.from(20261012, 20261111, 20261126, 20261225, 20270101, 20270118, 20270215, 20270531, 20270618, 20270705, 20270906, 20271011, 20271111, 20271125, 20271224, 20271231, 20280117, 20280221, 20280529, 20280619, 20280704, 20280904, 20281009, 20281110, 20281123, 20281225)
var array<int> noHol = array.new<int>()
var array<int> fomcDays = array.from(20261028, 20261209, 20270127, 20270317, 20270428, 20270609, 20270728, 20270915, 20271027, 20271208, 20280126)
// CPI ve Istihdam Raporu (NFP) gunleri, 08:30 ET. Her tarih en az iki bagimsiz kaynakla dogrulandi (arastirma/takvim.py).
// BLS 2027 takvimini yayimlayinca ekleyin. Son tarihten sonra 08:30 yalnizca mor kalir (eski davranis).
var array<int> bigDays = array.from(20261014, 20261106, 20261110, 20261204, 20261210)
etMin  = hour(time, NY) * 60 + minute(time, NY)
etDow  = dayofweek(time, NY)
etYmd  = year(time, NY) * 10000 + month(time, NY) * 100 + dayofmonth(time, NY)
isHol  = array.includes(nyHol, etYmd)
isDHol = array.includes(dataHol, etYmd)
isFomc = array.includes(fomcDays, etYmd)
wkDay  = etDow >= 2 and etDow <= 6
isBig     = array.includes(bigDays, etYmd)
dataDay   = not isDHol and etDow >= 3 and etDow <= 6
// 08:30: CPI/NFP gunlerinde 08:30 kirmizi (x6-11), 08:30-08:38 mor; diger Sali-Cuma gunlerinde yalnizca 08:30 mor (x1,5-2)
evData    = dataDay and (etMin == 510 or (isBig and etMin >= 510 and etMin <= 518))
evDataRed = dataDay and isBig and etMin == 510
evOpen    = not isHol and wkDay and etMin >= 570 and etMin <= 583
evTen     = not isDHol and wkDay and etMin >= 600 and etMin <= 608
evSun     = etDow == 1 and etMin >= 1080 and etMin <= 1087
evFomc    = isFomc and etMin >= 839 and etMin <= 884
evFomcRed = isFomc and etMin >= 840 and etMin <= 845
evNow     = evData or evOpen or evTen or evSun or evFomc
volHigh   = evNow or spikeAct or twoWay

// Belirli gun ve saatteki bir sonraki olayin zamani (en fazla 7 gun ileri), tatiller atlanabilir
nextEvent(int evH, int evM, string days, array<int> hol) =>
    int best = na
    todayNoon = timestamp(NY, year(time, NY), month(time, NY), dayofmonth(time, NY), 12, 0)
    for d = 0 to 7
        dn = todayNoon + d * 86400000
        ymd = year(dn, NY) * 10000 + month(dn, NY) * 100 + dayofmonth(dn, NY)
        evT = timestamp(NY, year(dn, NY), month(dn, NY), dayofmonth(dn, NY), evH, evM)
        okDay = str.contains(days, str.tostring(dayofweek(dn, NY))) and not array.includes(hol, ymd)
        if na(best) and okDay and evT >= time
            best := evT
    best

// Listedeki bir sonraki gun (FOMC 14:00 ET, CPI/NFP 08:30 ET)
nextListed(array<int> days, int evH, int evM) =>
    int best = na
    for ymd in days
        evT = timestamp(NY, int(math.floor(ymd / 10000)), int(math.floor((ymd % 10000) / 100)), ymd % 100, evH, evM)
        if na(best) and evT >= time
            best := evT
    best

tD = nextEvent(8, 30, "3456", dataHol)
tO = nextEvent(9, 30, "23456", nyHol)
tT = nextEvent(10, 0, "23456", dataHol)
tS = nextEvent(18, 0, "1", noHol)
tF = nextListed(fomcDays, 14, 0)
tB = nextListed(bigDays, 8, 30)
nxT = math.min(nz(tD, 9e15), nz(tO, 9e15), nz(tT, 9e15), nz(tS, 9e15), nz(tF, 9e15))
nxMin = nxT < 9e15 ? math.round((nxT - time) / 60000) : na
// Kalan gun: New York takvim gunu farki (olay gunu 0, bir gun once 1)
etDay0  = timestamp("UTC", year(time, NY), month(time, NY), dayofmonth(time, NY))
fomcDay = na(tF) ? na : math.round((timestamp("UTC", year(tF, NY), month(tF, NY), dayofmonth(tF, NY)) - etDay0) / 86400000)
bigDay  = na(tB) ? na : math.round((timestamp("UTC", year(tB, NY), month(tB, NY), dayofmonth(tB, NY)) - etDay0) / 86400000)
// Sari beklenen hareket: 08:30, 09:30, Pazar 18:00 ya da FOMC ufuktayken veya NY acilisinin ilk 14 dakikasinda bant oldugundan dar kalir
// (olcum: bu anlarda %80 bant her ay %64-75 kapsar, diger anlarda %81; 10:00 ufuktayken %78-83, sorun yok)
inH(int t) => not na(t) and t > time and t - time <= horizon * 60000
evInH   = inH(tD) or inH(tO) or inH(tS) or inH(tF) or evOpen

// === AL/SAT, stop, hedef ve pozisyon (v6.0; arastirma/sinyal_v6.py ile ayni kurallar) ===
// AL: yeni sert satis mumu kapandi (z15 <= -3, onceki 15 mumda sert satis yok). SAT: yeni sert alis mumu. Beklenen: kisa vadeli geri donus.
// Engeller (sabit 15 dk ufukla): zamanlanmis olay 15 dk icinde ya da suruyor (stop olcegi orada guvenilmez), acik islem var. Komisyon sinyali etkilemez (v6.1).
// Stop: stopK x sig15, hedef: tpR x stop mesafesi, holdMax dk sonra kapanista cikis. Ayni mumda stop ve hedef: once stop (ihtiyatli).
// Miktar: stopta kaybedilen tutar (mesafe + giris + stop cikisi maliyeti) = bakiye x risk %.
inH15(int t) => not na(t) and t > time and t - time <= 15 * 60000
evIn15   = inH15(tD) or inH15(tO) or inH15(tS) or inH15(tF) or evOpen
sig15    = math.sqrt(ewVar * 15)
newUp    = flowUp and upAgo >= 15
inFee    = entryX / 100
outStop  = takerX / 100
riskFrac = stopK * sig15 + inFee + outStop
qtyNow   = riskFrac > 0 ? balance * riskPct / 100 / (close * riskFrac) : na

var int   pos   = 0
var int   pend  = 0
var int   sigI  = na
var int   exitI = -1
var float sigS  = na
var float entP  = na
var float stopP = na
var float tgtP  = na
var int   nTr   = 0
var float sumR  = 0.0
exitNow = false
exitPx  = float(na)
exitTgt = false
// 1) Bir onceki mumda verilen sinyalin girisi (piyasa: bu mumun acilisi; limit: sinyal kapanisi, fiyat otesine gecerse dolar)
firstBar = false
if pend != 0
    if isLimit
        filled = pend > 0 ? low < entP : high > entP
        if filled
            pos := pend
            firstBar := true
    else
        entP := open
        pos := pend
        firstBar := true
    if pos != 0
        stopP := entP * math.exp(-pos * stopK * sigS)
        tgtP := entP * math.exp(pos * tpR * stopK * sigS)
    pend := 0
// 2) Acik islemin cikisi: stop, hedef (limit girisin dolum mumunda hedef sayilmaz) ya da sure
if pos != 0
    hitS = pos > 0 ? low <= stopP : high >= stopP
    hitT = pos > 0 ? high > tgtP : low < tgtP
    if firstBar and isLimit
        hitT := false
    if hitS
        po = firstBar and isLimit ? entP : open
        exitPx := pos > 0 ? math.min(stopP, po) : math.max(stopP, po)
        exitNow := true
    else if hitT
        exitPx := tgtP
        exitTgt := true
        exitNow := true
    else if bar_index - sigI >= holdMax
        exitPx := close
        exitNow := true
    if exitNow
        fOut = exitTgt ? makerFee / 100 : outStop
        netR = (pos * math.log(exitPx / entP) - inFee - fOut) / (stopK * sigS + inFee + outStop)
        nTr += 1
        sumR += netR
        pos := 0
        exitI := bar_index
// 3) Yeni sinyal (yalnizca kapanmis mumda; acik ya da bekleyen islem yokken)
canSig = showSig and barstate.isconfirmed and pos == 0 and pend == 0 and bar_index > exitI and not (evIn15 or evNow) and sig15 > 0
buySig  = canSig and newDn
sellSig = canSig and newUp and not newDn
if buySig or sellSig
    d = buySig ? 1 : -1
    pend := d
    sigI := bar_index
    sigS := sig15
    entP := close
    stopP := close * math.exp(-d * stopK * sig15)
    tgtP := close * math.exp(d * tpR * stopK * sig15)
    notional = qtyNow * close
    tip = "Giriş ≈ " + str.tostring(close, format.mintick) + (isLimit ? " (limit, sonraki mumda fiyat ötesine geçerse dolar)" : " (piyasa, sonraki mumun açılışı)") + "\nStop: " + str.tostring(stopP, format.mintick) + " (" + str.tostring(stopK * sig15 * 100, "#.##") + "%)" + "\nHedef: " + str.tostring(tgtP, format.mintick) + " (" + str.tostring(tpR * stopK * sig15 * 100, "#.##") + "%)" + "\nEn uzun tutma: " + str.tostring(holdMax) + " dk, sonra kapanışta çık" + "\nMiktar: " + str.tostring(qtyNow, "#.####") + " (≈ " + str.tostring(notional, "#") + " USDT, kaldıraç " + str.tostring(notional / balance, "#.#") + "x)" + "\nStopta kayıp ≈ " + str.tostring(balance * riskPct / 100, "#.##") + " USDT (maliyet dahil)"
    label.new(bar_index, d > 0 ? low : high, (d > 0 ? "AL" : "SAT") + "\n" + str.tostring(qtyNow, "#.####"), style = d > 0 ? label.style_label_up : label.style_label_down, color = d > 0 ? cBuy : cSell, textcolor = color.black, size = size.small, tooltip = tip)
tradeOn = pos != 0 or pend != 0 or exitNow

// SMA20 yonu (CM Ultimate MA, yumusatma 2): yesil yukari, kirmizi asagi. Renk donusu ve fiyatin cizgiyi mum icinde kesmesi
// iki yilda da kucuk ama tutarli brut kazanc verdi (+0,5 / +0,3 bp ve +0,2 / +0,2 bp; arastirma/katki_testi.py, BULGULAR 15).
sma20 = ta.sma(close, 20)
smaUp = sma20 >= sma20[2]

// Uyumsuzluk: "Divergence for Many Indicators v4" (LonesomeTheBlue, MPL 2.0) mantiginin uyarlamasi. Normal uyumsuzluk, kapanis pivotlari (5), onay bekler,
// 10 gosterge: MACD, MACD histogram, RSI, Stokastik, CCI, Momentum, OBV, VW-MACD, CMF, MFI. Ilk pozitif uyumsuzluk mumu yesil, ilk negatif kirmizi ucgen.
// Test (komisyonsuz, 22 parite): iki yilda da kucuk ama tutarli brut kazanc, +0,3 / +0,5 bp (arastirma/katki_testi2.py, BULGULAR 16).
dvPh = ta.pivothigh(close, 5, 5)
dvPl = ta.pivotlow(close, 5, 5)
var array<int> dvPhPos = array.new_int(20, 0)
var array<float> dvPhVal = array.new_float(20, 0.0)
var array<int> dvPlPos = array.new_int(20, 0)
var array<float> dvPlVal = array.new_float(20, 0.0)
if not na(dvPh)
    array.unshift(dvPhPos, bar_index)
    array.unshift(dvPhVal, dvPh)
    array.pop(dvPhPos)
    array.pop(dvPhVal)
if not na(dvPl)
    array.unshift(dvPlPos, bar_index)
    array.unshift(dvPlVal, dvPl)
    array.pop(dvPlPos)
    array.pop(dvPlVal)
dvPos(float src) =>
    int found = 0
    if src > src[1] or close > close[1]
        for x = 0 to 9
            int len = bar_index - array.get(dvPlPos, x) + 5
            if array.get(dvPlPos, x) == 0 or len > 100
                break
            if len > 5 and src[1] > src[len] and close[1] < array.get(dvPlVal, x)
                float s1 = (src[1] - src[len]) / (len - 1)
                float v1 = src[1] - s1
                float s2 = (close[1] - close[len]) / (len - 1)
                float v2 = close[1] - s2
                bool ok = true
                for y = 2 to len - 1
                    if src[y] < v1 or close[y] < v2
                        ok := false
                        break
                    v1 -= s1
                    v2 -= s2
                if ok
                    found := 1
                    break
    found
dvNeg(float src) =>
    int found = 0
    if src < src[1] or close < close[1]
        for x = 0 to 9
            int len = bar_index - array.get(dvPhPos, x) + 5
            if array.get(dvPhPos, x) == 0 or len > 100
                break
            if len > 5 and src[1] < src[len] and close[1] > array.get(dvPhVal, x)
                float s1 = (src[1] - src[len]) / (len - 1)
                float v1 = src[1] - s1
                float s2 = (close[1] - close[len]) / (len - 1)
                float v2 = close[1] - s2
                bool ok = true
                for y = 2 to len - 1
                    if src[y] > v1 or close[y] > v2
                        ok := false
                        break
                    v1 -= s1
                    v2 -= s2
                if ok
                    found := 1
                    break
    found
[dvMacd, dvSig, dvHist] = ta.macd(close, 12, 26, 9)
dvRsi  = ta.rsi(close, 14)
dvStk  = ta.sma(ta.stoch(close, high, low, 14), 3)
dvCci  = ta.cci(close, 10)
dvMom  = ta.mom(close, 10)
dvObv  = ta.obv
dvVwm  = ta.vwma(close, 12) - ta.vwma(close, 26)
dvCmfm = high > low ? ((close - low) - (high - close)) / (high - low) : 0.0
dvCmf  = ta.sma(dvCmfm * volume, 21) / ta.sma(volume, 21)
dvMfi  = ta.mfi(close, 14)
dvPosN = dvPos(dvMacd) + dvPos(dvHist) + dvPos(dvRsi) + dvPos(dvStk) + dvPos(dvCci) + dvPos(dvMom) + dvPos(dvObv) + dvPos(dvVwm) + dvPos(dvCmf) + dvPos(dvMfi)
dvNegN = dvNeg(dvMacd) + dvNeg(dvHist) + dvNeg(dvRsi) + dvNeg(dvStk) + dvNeg(dvCci) + dvNeg(dvMom) + dvNeg(dvObv) + dvNeg(dvVwm) + dvNeg(dvCmf) + dvNeg(dvMfi)
divBull = dvPosN > 0 and nz(dvPosN[1]) == 0 and dvNegN == 0
divBear = dvNegN > 0 and nz(dvNegN[1]) == 0 and dvPosN == 0

// Trend cizgisi kirilimi: "Trend Lines v2" (LonesomeTheBlue, MPL 2.0) mantiginin uyarlamasi. Pivot 20 (yuksek/dusuk), son 3 pivot; o ana kadarki her kapanisin
// ustunde kalan yukselen ve altinda kalan dusen cizgiler (en fazla 2 + 2). Kapanis gecerli bir yukselen cizginin altina inerse SAT oku, dusen cizginin ustune
// cikarsa AL oku (cizginin ilk kirilim mumu). Gostergenin kendi sinyali yok; kirilim tanimi on kayitli testteki gibi.
// Test (komisyonsuz, 22 parite, piyasa girisi, stop 1 sigma15, hedef 2R, en fazla 30 dk): brut +1,3 / +0,7 bp, t 4,8 / 3,1; 2026'da kazanc SAT tarafinda
// (arastirma/katki_testi3.py, BULGULAR 17). Cizgi kontrolu en fazla 990 mum geriye bakar (Pine gecmis siniri).
tlPrd = 20
tlPh = ta.pivothigh(high, tlPrd, tlPrd)
tlPl = ta.pivotlow(low, tlPrd, tlPrd)
var array<float> tlTv = array.new_float(3, na)
var array<int> tlTp = array.new_int(3, 0)
var array<float> tlBv = array.new_float(3, na)
var array<int> tlBp = array.new_int(3, 0)
if not na(tlPh)
    array.unshift(tlTv, tlPh)
    array.unshift(tlTp, bar_index)
    array.pop(tlTv)
    array.pop(tlTp)
if not na(tlPl)
    array.unshift(tlBv, tlPl)
    array.unshift(tlBp, bar_index)
    array.pop(tlBv)
    array.pop(tlBp)
// Iki pivottan gecen cizgi: gecerliyse bir sonraki muma uzatilmis deger ve cizimin baslangici (pivot mumu); gecersizse na
tlLine(float v1, int p1, float v2, int p2, bool up) =>
    float res = na
    int xs = na
    float ys = na
    if not na(v1) and not na(v2) and (up ? v1 > v2 : v1 < v2)
        int x0 = p2 + 1 - tlPrd
        if bar_index - x0 <= 990
            float d = up ? (v1 - v2) / (p1 - p2) : (v2 - v1) / (p1 - p2)
            float hl = up ? v2 + d : v2 - d
            bool ok = true
            for x = x0 to bar_index
                float cx = close[bar_index - x]
                if up ? cx < hl : cx > hl
                    ok := false
                    break
                hl := up ? hl + d : hl - d
            if ok
                res := hl
                xs := p2 - tlPrd
                ys := v2
    [res, xs, ys]
[tlUa1, tlUaX1, tlUaY1] = tlLine(array.get(tlBv, 0), array.get(tlBp, 0), array.get(tlBv, 2), array.get(tlBp, 2), true)
[tlUa2, tlUaX2, tlUaY2] = tlLine(array.get(tlBv, 0), array.get(tlBp, 0), array.get(tlBv, 1), array.get(tlBp, 1), true)
[tlUb, tlUbX, tlUbY] = tlLine(array.get(tlBv, 1), array.get(tlBp, 1), array.get(tlBv, 2), array.get(tlBp, 2), true)
[tlDa1, tlDaX1, tlDaY1] = tlLine(array.get(tlTv, 0), array.get(tlTp, 0), array.get(tlTv, 2), array.get(tlTp, 2), false)
[tlDa2, tlDaX2, tlDaY2] = tlLine(array.get(tlTv, 0), array.get(tlTp, 0), array.get(tlTv, 1), array.get(tlTp, 1), false)
[tlDb, tlDbX, tlDbY] = tlLine(array.get(tlTv, 1), array.get(tlTp, 1), array.get(tlTv, 2), array.get(tlTp, 2), false)
tlUa = na(tlUa1) ? tlUa2 : tlUa1
tlDa = na(tlDa1) ? tlDa2 : tlDa1
tlCutUp = (not na(tlUa[1]) and close < tlUa[1]) or (not na(tlUb[1]) and close < tlUb[1])
tlCutDn = (not na(tlDa[1]) and close > tlDa[1]) or (not na(tlDb[1]) and close > tlDb[1])
tlBuy = tlCutDn and not tlCutUp
tlSell = tlCutUp and not tlCutDn

// === Cizimler (en kalin, acik renkler) ===
// Gun degisiminde (00:00 UTC) ilk mumda cizgi kesilir; boylece eski ve yeni gun degerleri dikey bir cizgiyle birlesmez
dayOn = showLevels and not newDay
plot(dayOn ? vwapV : na, "VWAP", cVwap, 4, plot.style_linebr, display = display.pane)
plot(dayOn ? vwapU : na, "VWAP +2σ", cBand, 4, plot.style_linebr, linestyle = plot.linestyle_dashed, display = display.pane)
plot(dayOn ? vwapL : na, "VWAP -2σ", cBand, 4, plot.style_linebr, linestyle = plot.linestyle_dashed, display = display.pane)
plot(dayOn ? pdh : na, "Önceki gün yüksek", cDay, 4, plot.style_linebr, linestyle = plot.linestyle_dotted, display = display.pane)
plot(dayOn ? pdl : na, "Önceki gün düşük", cDay, 4, plot.style_linebr, linestyle = plot.linestyle_dotted, display = display.pane)
plot(showLevels ? asiaHi : na, "Asya yüksek", cAsia, 4, plot.style_linebr, linestyle = plot.linestyle_dashed, display = display.pane)
plot(showLevels ? asiaLo : na, "Asya düşük", cAsia, 4, plot.style_linebr, linestyle = plot.linestyle_dashed, display = display.pane)
plot(showSma ? sma20 : na, "SMA20", smaUp ? cGood : cBad, 4, display = display.pane)
plotshape(showDiv and divBull and barstate.isconfirmed, "Pozitif uyumsuzluk", shape.triangleup, location.belowbar, cGood, size = size.tiny, display = display.pane)
plotshape(showDiv and divBear and barstate.isconfirmed, "Negatif uyumsuzluk", shape.triangledown, location.abovebar, cBad, size = size.tiny, display = display.pane)
plotshape(showTl and tlBuy and barstate.isconfirmed, "Trend çizgisi kırılımı: AL", shape.arrowup, location.belowbar, cBuy, size = size.tiny, display = display.pane)
plotshape(showTl and tlSell and barstate.isconfirmed, "Trend çizgisi kırılımı: SAT", shape.arrowdown, location.abovebar, cSell, size = size.tiny, display = display.pane)
// Gecerli trend cizgileri yalnizca son mumda cizilir (pivotlardan bir sonraki muma kadar; uc nokta = bir sonraki kapanis icin kirilim seviyesi)
var array<line> tlLines = array.new<line>()
if barstate.islast
    while array.size(tlLines) > 0
        line.delete(array.pop(tlLines))
    if showTl
        if not na(tlUa)
            array.push(tlLines, line.new(na(tlUa1) ? tlUaX2 : tlUaX1, na(tlUa1) ? tlUaY2 : tlUaY1, bar_index + 1, tlUa, color = cGood, width = 2))
        if not na(tlUb)
            array.push(tlLines, line.new(tlUbX, tlUbY, bar_index + 1, tlUb, color = cGood, width = 2))
        if not na(tlDa)
            array.push(tlLines, line.new(na(tlDa1) ? tlDaX2 : tlDaX1, na(tlDa1) ? tlDaY2 : tlDaY1, bar_index + 1, tlDa, color = cBad, width = 2))
        if not na(tlDb)
            array.push(tlLines, line.new(tlDbX, tlDbY, bar_index + 1, tlDb, color = cBad, width = 2))
plot(tradeOn ? stopP : na, "Stop", cSell, 3, plot.style_linebr, display = display.pane + display.data_window)
plot(tradeOn ? tgtP : na, "Hedef", cBuy, 3, plot.style_linebr, display = display.pane + display.data_window)

// Arka plan: kirmizi > turuncu > mor (ayni anda yalnizca biri)
redOn  = showVolBg and (evFomcRed or evDataRed)
flowOn = showFlowBg and chaseShort and not redOn
bgcolor(redOn ? cRedBg : na, title = "FOMC ilk dakikalar / CPI-NFP 08:30")
bgcolor(flowOn ? cFlowBg : na, title = "Sert satış sonrası (SHORT kovalama)")
bgcolor(showVolBg and volHigh and not redOn and not flowOn ? cVolBg : na, title = "Olağandışı oynaklık")

// === Durum satiri ve veri penceresi (grafige cizilmez) ===
mcCol = moveCost >= 2 ? cGood : moveCost >= 1 ? cWarn : cBad
nxCol = evNow ? cEvent : nxMin <= 15 ? cWarn : cInfo
emCol = evInH ? cWarn : cInfo
plot(moveCost, "Hareket / maliyet (kat)", mcCol, display = display.status_line + display.data_window, precision = 1)
plot(em50 * 100, "Beklenen hareket ±% (%50)", emCol, display = display.status_line + display.data_window, precision = 2)
plot(em80 * 100, "Beklenen hareket ±% (%80)", emCol, display = display.status_line + display.data_window, precision = 2)
plot(nxMin, "Sıradaki oynaklık anına kalan dk", nxCol, display = display.status_line + display.data_window, precision = 0)
plot(fomcDay, "Sıradaki FOMC'ye kalan gün", cInfo, display = display.data_window, precision = 0)
plot(bigDay, "Sıradaki CPI/NFP'ye kalan gün", cInfo, display = display.data_window, precision = 0)
plot(slipEff, "Kullanılan kayma % (tek yön, en az yarım tick)", cInfo, display = display.data_window, precision = 3)
plot(z15, "Son 15 dk hareket (z)", cInfo, display = display.data_window, precision = 1)
plot(imb15 * 100, "Tahmini delta % (son 15 dk)", cInfo, display = display.data_window, precision = 0)
plot(atr / close * 100, "1 dk ATR %", cInfo, display = display.data_window, precision = 3)
plot(qtyNow, "Önerilen miktar (şimdi girilse)", cInfo, display = display.data_window, precision = 4)
plot(qtyNow * close, "Pozisyon değeri USDT (şimdi girilse)", cInfo, display = display.data_window, precision = 0)
plot(stopK * sig15 * 100, "Stop mesafesi %", cInfo, display = display.data_window, precision = 2)
plot(nTr, "Grafikteki AL/SAT işlemleri", cInfo, display = display.data_window, precision = 0)
plot(nTr > 0 ? sumR / nTr : na, "Grafikteki işlemlerin ortalama net R'si", cInfo, display = display.data_window, precision = 2)

// === Alarmlar (mum kapanisinda) ===
alertcondition(buySig, "VSP: AL", "VSP: AL sinyali (sert satıştan sonra geri dönüş). Stop ve hedef grafikte.")
alertcondition(sellSig, "VSP: SAT", "VSP: SAT sinyali (sert alıştan sonra geri dönüş). Stop ve hedef grafikte.")
alertcondition(barstate.isconfirmed and tlBuy, "VSP: Trend çizgisi kırılımı AL", "VSP: Kapanış düşen trend çizgisinin üstüne çıktı.")
alertcondition(barstate.isconfirmed and tlSell, "VSP: Trend çizgisi kırılımı SAT", "VSP: Kapanış yükselen trend çizgisinin altına indi.")
alertcondition(barstate.isconfirmed and newDn, "VSP: Sert satış akışı", "VSP: Sert satış akışı. Sonraki mumda SHORT kovalamak ortalamada dezavantajlı.")
alertcondition(barstate.isconfirmed and volHigh and not volHigh[1], "VSP: Olağandışı oynaklık", "VSP: Olağandışı oynaklık başladı.")
// VSP SONU - bu satiri goremiyorsaniz kod eksik kopyalanmistir
