//@version=6
// Vadeli Scalp Pusulasi (VSP) - v3.0.0
// 1 dakikalik kripto vadeli islemler icin iki kurulum:
//   1) Trend devami: ust ZD + VWAP + EMA trendinde geri cekilme sonrasi donus
//   2) Likidite supurme: onceki gun / Asya / yuvarlak sayi / salinim seviyesinin otesine igne atip geri kapanis
// Disiplinler: piyasa mikro yapisi (BVC delta, VPIN, Amihud), ekonometri (varyans orani), davranissal finans (yuvarlak sayilar),
// bilgi kurami (Kelly), istatistik (t-testi). Sinyaller yalnizca mum kapanisinda olusur, repaint yapmaz.
indicator("Vadeli Scalp Pusulası", shorttitle = "VSP", overlay = true, max_labels_count = 500)

// === Girdiler ===
grpS = "Sinyal"
minScore  = input.int(60, "En düşük skor (0-100)", minval = 0, maxval = 100, group = grpS)
useTrend  = input.bool(true, "Trend devamı sinyalleri", group = grpS)
useSweep  = input.bool(true, "Likidite süpürme sinyalleri", group = grpS)
cooldown  = input.int(5, "Sinyaller arası en az mum", minval = 0, group = grpS)
fundBlock = input.int(3, "Fonlama saatine ± dk sinyal verme", minval = 0, group = grpS)
fundHours = input.int(8, "Fonlama aralığı (saat)", options = [1, 2, 4, 8], group = grpS)

grpT = "Trend"
emaFastLen = input.int(9, "Hızlı EMA", minval = 1, group = grpT)
emaSlowLen = input.int(21, "Yavaş EMA", minval = 1, group = grpT)
htf        = input.timeframe("15", "Üst zaman dilimi", group = grpT)
htfLen     = input.int(50, "Üst ZD EMA", minval = 1, group = grpT)
btcSym     = input.symbol("BINANCE:BTCUSDT.P", "Lider sembol (altcoinler için)", group = grpT)

grpF = "Filtreler"
erLen    = input.int(20, "Verimlilik oranı (ER) uzunluğu", minval = 2, group = grpF)
erMin    = input.float(0.25, "Trend için en düşük ER", step = 0.05, group = grpF)
adxLen   = input.int(14, "ADX uzunluğu", minval = 1, group = grpF)
adxMin   = input.float(20, "En düşük ADX", group = grpF)
rvolLen  = input.int(20, "Hacim ortalaması", minval = 1, group = grpF)
rvolMin  = input.float(1.3, "En düşük göreli hacim", step = 0.1, group = grpF)
rsiLen   = input.int(14, "RSI uzunluğu", minval = 1, group = grpF)
rsiMaxL  = input.float(72, "Alışta en yüksek RSI", group = grpF)
rsiMinS  = input.float(28, "Satışta en düşük RSI", group = grpF)
swLeft   = input.int(10, "Salınım noktası sol mum", minval = 1, group = grpF)
swRight  = input.int(3, "Salınım noktası sağ mum", minval = 1, group = grpF)
roundMul = input.float(5, "Yuvarlak sayı adımı (fiyat basamağı x)", step = 1, group = grpF)

grpM = "Mikro yapı"
bvcLen   = input.int(100, "BVC oynaklık penceresi", minval = 10, group = grpM)
dLen     = input.int(3, "Delta penceresi (mum)", minval = 1, group = grpM)
dMin     = input.float(0.10, "En düşük delta oranı", step = 0.05, group = grpM)
vpinLen  = input.int(50, "VPIN penceresi (mum)", minval = 10, group = grpM)
vpinMax  = input.float(90, "Toksik akış yüzdeliği", minval = 50, maxval = 100, group = grpM)
vrQ      = input.int(15, "Varyans oranı ufku (mum)", minval = 2, group = grpM)
vrWin    = input.int(240, "Varyans oranı penceresi (mum)", minval = 50, group = grpM)
chaseZ   = input.float(2.0, "Kovalamaca sınırı (15 mum z)", step = 0.5, group = grpM)
oiLen    = input.int(5, "OI değişim penceresi (mum)", minval = 1, group = grpM)
premLen  = input.int(240, "Prim z-skoru penceresi (mum)", minval = 20, group = grpM)
premZMax = input.float(2.0, "Kalabalık sayılan prim z-skoru", step = 0.5, group = grpM)

grpR = "Risk ve maliyet"
atrLen     = input.int(14, "ATR uzunluğu", minval = 1, group = grpR)
stopLook   = input.int(5, "Stop için geriye bakış (mum)", minval = 1, group = grpR)
stopBuf    = input.float(0.2, "Stop tamponu (ATR x)", step = 0.1, group = grpR)
minStopAtr = input.float(0.6, "En dar stop (ATR x)", step = 0.1, group = grpR)
maxStopAtr = input.float(2.5, "En geniş stop (ATR x)", step = 0.1, group = grpR)
tp1R       = input.float(1.0, "TP1 (R)", step = 0.1, group = grpR)
tp2R       = input.float(2.0, "TP2 (R)", step = 0.1, group = grpR)
partQ      = input.float(50, "TP1'de kapatılan %", minval = 0, maxval = 100, step = 10, group = grpR) / 100
timeStop   = input.int(20, "Zaman stopu (mum, TP1 öncesi)", minval = 1, group = grpR)
feeSide    = input.float(0.05, "Tek yön komisyon %", step = 0.005, group = grpR)
slipSide   = input.float(0.01, "Tek yön kayma % (normal likidite)", step = 0.005, group = grpR)
maxCostR   = input.float(0.30, "En yüksek maliyet / risk (R)", step = 0.05, group = grpR)
spikeAtr   = input.float(4.0, "Aşırı mum sınırı (ATR x)", step = 0.5, group = grpR)

grpV = "Görünüm"
showBands = input.bool(true, "VWAP bantları", group = grpV)
showLiq   = input.bool(true, "Likidite seviyeleri", group = grpV)
showPos   = input.bool(true, "Giriş/Stop/TP seviyeleri", group = grpV)
showPanel = input.bool(true, "Piyasa paneli", group = grpV)
showStats = input.bool(true, "Performans paneli", group = grpV)

// === Temel hesaplar ve cizimler ===
emaF = ta.ema(close, emaFastLen)
emaS = ta.ema(close, emaSlowLen)
[vwapV, vwapU, vwapL] = ta.vwap(hlc3, timeframe.change("D"), 2.0)

pF = plot(emaF, "Hızlı EMA", color.new(color.teal, 0), 1)
pS = plot(emaS, "Yavaş EMA", color.new(color.maroon, 0), 1)
fill(pF, pS, emaF > emaS ? color.new(color.teal, 85) : color.new(color.maroon, 85), title = "EMA bulutu")
plot(vwapV, "VWAP", color.new(color.orange, 0), 2)
plot(showBands ? vwapU : na, "VWAP üst", color.new(color.orange, 70), 1)
plot(showBands ? vwapL : na, "VWAP alt", color.new(color.orange, 70), 1)

// Ust zaman dilimi: kapanmis muma gore, repaint yok
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, htfLen)[1], lookahead = barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead = barmerge.lookahead_on)
htfUp = htfClose > htfEma
htfDn = htfClose < htfEma

// BTC liderligi (altcoinler BTC ile ayni dakikada hareket eder)
isBtc = syminfo.basecurrency == "BTC"
[btcC, btcE, btcV] = request.security(btcSym, timeframe.period, [close, ta.ema(close, emaSlowLen), ta.vwap(hlc3)], ignore_invalid_symbol = true)
btcOk = not na(btcC) and not na(btcE) and not na(btcV)
btcUp = btcOk and btcC > btcE and btcC > btcV
btcDn = btcOk and btcC < btcE and btcC < btcV

// Acik pozisyon (OI): yalnizca vadeli (.P) grafiklerde veri gelir
oiSym = syminfo.prefix + ":" + syminfo.ticker + "_OI"
oi = request.security(oiSym, timeframe.period, close, ignore_invalid_symbol = true)
oiCh = not na(oi) and not na(oi[oiLen]) and oi[oiLen] != 0 ? (oi - oi[oiLen]) / oi[oiLen] * 100 : na
oiOk = not na(oiCh)

// Vadeli prim: kendi gecmisine gore z-skoru. Asiri pozitif = longlar kalabalik
premSym = syminfo.prefix + ":" + syminfo.ticker + "_PREMIUM"
prem = request.security(premSym, timeframe.period, close, ignore_invalid_symbol = true)
premMa = ta.sma(prem, premLen)
premSd = ta.stdev(prem, premLen)
premZ = not na(prem) and not na(premSd) and premSd > 0 ? (prem - premMa) / premSd : na
premOk = not na(premZ)
longCrowd = premOk and premZ >= premZMax
shortCrowd = premOk and premZ <= -premZMax

// Likidite seviyeleri: onceki gun, Asya seansi (00-08 UTC), son salinim noktalari
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)

newDay = timeframe.change("D")
inAsia = not na(time(timeframe.period, "0000-0800", "UTC"))
var float asiaHT = na
var float asiaLT = na
if newDay
    asiaHT := high
    asiaLT := low
else if inAsia
    asiaHT := math.max(nz(asiaHT, high), high)
    asiaLT := math.min(nz(asiaLT, low), low)
asiaHi = not inAsia ? asiaHT : na
asiaLo = not inAsia ? asiaLT : na

ph = ta.pivothigh(high, swLeft, swRight)
pl = ta.pivotlow(low, swLeft, swRight)
var float swH = na
var float swL = na
if not na(ph)
    swH := ph
if not na(pl)
    swL := pl

plot(showLiq ? pdh : na, "Önceki gün yüksek", color.new(color.gray, 20), 1, plot.style_linebr)
plot(showLiq ? pdl : na, "Önceki gün düşük", color.new(color.gray, 20), 1, plot.style_linebr)
plot(showLiq ? asiaHi : na, "Asya yüksek", color.new(color.purple, 30), 1, plot.style_linebr)
plot(showLiq ? asiaLo : na, "Asya düşük", color.new(color.purple, 30), 1, plot.style_linebr)

// Yuvarlak sayilar (Osler): kar-al emirleri tam yuvarlak sayida, stoplar hemen otesinde kumelenir
rStep = roundMul * math.pow(10, math.floor(math.log10(close)) - 2)
rNear = math.round(close / rStep) * rStep
plot(showLiq ? rNear : na, "Yuvarlak sayı", color.new(color.silver, 60), 1, plot.style_circles)

// Guc ve hacim
[diP, diM, adx] = ta.dmi(adxLen, adxLen)
rsi   = ta.rsi(close, rsiLen)
atr   = ta.atr(atrLen)
volMa = ta.sma(volume, rvolLen)
rvol  = volMa > 0 ? volume / volMa : 0.0

// Kaufman verimlilik orani: 0 = gurultu, 1 = dumduz hareket
noise = math.sum(math.abs(close - close[1]), erLen)
er    = noise > 0 ? math.abs(close - close[erLen]) / noise : 0.0

// Mum ici kapanis konumu (supurme reddi icin)
rng = high - low
clv = rng > 0 ? ((close - low) - (high - close)) / rng : 0.0

// BVC delta (Easley, Lopez de Prado, O'Hara): alis payi = Phi(fiyat degisimi / oynaklik)
bvcCdf(float z) => 1.0 / (1.0 + math.exp(-1.702 * z))
dp      = close - close[1]
dpSd    = ta.stdev(dp, bvcLen)
buyFrac = dpSd > 0 ? bvcCdf(dp / dpSd) : 0.5
sVol    = volume * (2 * buyFrac - 1)
dSumV   = math.sum(volume, dLen)
dRatio  = dSumV > 0 ? math.sum(sVol, dLen) / dSumV : 0.0

// VPIN: akis toksisitesi. Yuksek degerler yakin vadede sicrama riskine isaret eder
vSumV  = math.sum(volume, vpinLen)
vpin   = vSumV > 0 ? math.sum(math.abs(sVol), vpinLen) / vSumV : 0.0
vpinPr = ta.percentrank(vpin, 500)
toxic  = vpinPr >= vpinMax

// Varyans orani (Lo-MacKinlay): VR > 1 momentum, VR < 1 ters donus egilimi
r1   = math.log(close / close[1])
rq   = math.log(close / close[vrQ])
v1   = ta.variance(r1, vrWin)
vq   = ta.variance(rq, vrWin)
vr   = v1 > 0 ? vq / (vrQ * v1) : na
vrOk = not na(vr)
rqSd = ta.stdev(rq, vrWin)
z15  = rqSd > 0 ? rq / rqSd : 0.0

// Likidite (Amihud): fiyat etkisi / dolar hacmi, kendi uzun vadeli seviyesine oranla
illiq   = volume > 0 ? math.abs(r1) / (volume * close) : 0.0
illiqS  = math.max(ta.sma(illiq, 20), 1e-15)
illiqB  = math.exp(ta.ema(math.log(illiqS), 1440))
liqMult = not na(illiqB) and illiqB > 0 ? math.max(0.5, math.min(3.0, illiqS / illiqB)) : 1.0

// Asiri mum: haber/tasfiye mumunda kayma yuksek olur
spikeT = rng > spikeAtr * nz(atr[1], atr)
spikeS = rng > spikeAtr * 2 * nz(atr[1], atr)

// Zaman: likit saatler, fonlama penceresi, ceyrek saat acilisi (UTC)
hUtc        = hour(time, "UTC")
liquidHour  = hUtc >= 7 and hUtc < 21
minsSince   = (hUtc % fundHours) * 60 + minute(time, "UTC")
fundPeriod  = fundHours * 60
nearFunding = fundBlock > 0 and (minsSince < fundBlock or minsSince >= fundPeriod - fundBlock)
qhMult      = minute(time_close, "UTC") % 15 == 0 ? 1.5 : 1.0

// === Stop mesafeleri ve maliyet ===
clampD(float d) => math.min(math.max(d, atr * minStopAtr), atr * maxStopAtr)

lowN  = ta.lowest(low, stopLook)
highN = ta.highest(high, stopLook)
dTL = clampD(close - (lowN - atr * stopBuf))
dTS = clampD((highN + atr * stopBuf) - close)
dSL = clampD(close - (low - atr * stopBuf))
dSS = clampD((high + atr * stopBuf) - close)

slipEff = slipSide * liqMult * qhMult
costPct = 2 * (feeSide + slipEff)
costPx  = close * costPct / 100

// === Kurulum 1: Trend devami ===
upTrend  = emaF > emaS and close > vwapV
dnTrend  = emaF < emaS and close < vwapV
trendReg = er >= erMin

longTrig  = ta.crossover(close, emaF) or (low <= emaF and close > emaF and close > open)
shortTrig = ta.crossunder(close, emaF) or (high >= emaF and close < emaF and close < open)

// Hedef yonunde yakin yuvarlak sayi = kar-al duvari
nextUp = math.floor(close / rStep) * rStep + rStep
nextDn = math.ceil(close / rStep) * rStep - rStep
roomL  = nextUp - close >= 0.5 * dTL
roomS  = close - nextDn >= 0.5 * dTS

tRawL = (htfUp ? 20 : 0) + (isBtc or btcUp ? 15 : btcOk ? 0 : 8) + (trendReg ? 15 : 0) + (adx >= adxMin and diP > diM ? 10 : 0) + (dRatio >= dMin ? 15 : 0) + (oiOk ? (oiCh > 0 ? 10 : 0) : 5) + (rvol >= rvolMin ? 10 : 0) + (liquidHour ? 5 : 0) + (vrOk ? (vr > 1 ? 10 : 0) : 5) - (longCrowd ? 10 : 0) - (z15 >= chaseZ ? 10 : 0) - (roomL ? 0 : 10)
tRawS = (htfDn ? 20 : 0) + (isBtc or btcDn ? 15 : btcOk ? 0 : 8) + (trendReg ? 15 : 0) + (adx >= adxMin and diM > diP ? 10 : 0) + (dRatio <= -dMin ? 15 : 0) + (oiOk ? (oiCh > 0 ? 10 : 0) : 5) + (rvol >= rvolMin ? 10 : 0) + (liquidHour ? 5 : 0) + (vrOk ? (vr > 1 ? 10 : 0) : 5) - (shortCrowd ? 10 : 0) - (z15 <= -chaseZ ? 10 : 0) - (roomS ? 0 : 10)
tScoreL = math.max(0, math.min(100, math.round(tRawL * 100.0 / 110)))
tScoreS = math.max(0, math.min(100, math.round(tRawS * 100.0 / 110)))

tValidL = useTrend and upTrend and longTrig and rsi < rsiMaxL and close < vwapU and not spikeT
tValidS = useTrend and dnTrend and shortTrig and rsi > rsiMinS and close > vwapL and not spikeT

// === Kurulum 2: Likidite supurme ===
sweptBelow(float lvl) => not na(lvl) and low < lvl and close > lvl
sweptAbove(float lvl) => not na(lvl) and high > lvl and close < lvl

rAboveLow  = math.ceil(low / rStep) * rStep
rBelowHigh = math.floor(high / rStep) * rStep

lvlL = sweptBelow(pdl) ? 25 : sweptBelow(asiaLo) ? 20 : sweptBelow(rAboveLow) ? 15 : sweptBelow(swL) ? 10 : 0
lvlS = sweptAbove(pdh) ? 25 : sweptAbove(asiaHi) ? 20 : sweptAbove(rBelowHigh) ? 15 : sweptAbove(swH) ? 10 : 0

// Ters donus, saldirgan akistan sonra guclenir (15 dk ters donus calismasi)
sRawL = lvlL + (rvol >= rvolMin ? 20 : 0) + (clv >= 0.5 ? 15 : 0) + (oiOk ? (oiCh < 0 ? 15 : 0) : 7) + (isBtc or not btcDn ? 10 : 0) + (close < vwapV ? 15 : 0) + (vrOk ? (vr < 1 ? 10 : 0) : 5) + (dRatio[1] <= -2 * dMin ? 10 : 0) + (shortCrowd ? 10 : 0)
sRawS = lvlS + (rvol >= rvolMin ? 20 : 0) + (clv <= -0.5 ? 15 : 0) + (oiOk ? (oiCh < 0 ? 15 : 0) : 7) + (isBtc or not btcUp ? 10 : 0) + (close > vwapV ? 15 : 0) + (vrOk ? (vr < 1 ? 10 : 0) : 5) + (dRatio[1] >= 2 * dMin ? 10 : 0) + (longCrowd ? 10 : 0)
sScoreL = math.max(0, math.min(100, math.round(sRawL * 100.0 / 130)))
sScoreS = math.max(0, math.min(100, math.round(sRawS * 100.0 / 130)))

sValidL = useSweep and lvlL > 0 and clv >= 0.2 and not spikeS and not toxic and not (dnTrend and trendReg and htfDn)
sValidS = useSweep and lvlS > 0 and clv <= -0.2 and not spikeS and not toxic and not (upTrend and trendReg and htfUp)

// === Secim ===
okTL = tValidL and tScoreL >= minScore and costPx / dTL <= maxCostR
okSL = sValidL and sScoreL >= minScore and costPx / dSL <= maxCostR
okTS = tValidS and tScoreS >= minScore and costPx / dTS <= maxCostR
okSS = sValidS and sScoreS >= minScore and costPx / dSS <= maxCostR

longType  = okTL and (not okSL or tScoreL >= sScoreL) ? 1 : okSL ? 2 : 0
shortType = okTS and (not okSS or tScoreS >= sScoreS) ? 1 : okSS ? 2 : 0
longSc    = longType == 1 ? tScoreL : longType == 2 ? sScoreL : 0
shortSc   = shortType == 1 ? tScoreS : shortType == 2 ? sScoreS : 0

// === Pozisyon takibi ===
var int dir = 0
var int posType = 0
var int posScore = 0
var float entry = na
var float sl = na
var float tp1 = na
var float tp2 = na
var float risk = na
var float cost = na
var float realized = 0.0
var bool tp1Hit = false
var int entryBar = na
var int lastSig = na
var string status = "Bekle"

float closedR = na
string closedTxt = ""

// Acik pozisyonun sonucu (giris mumundan sonra). Ayni mumda stop ve hedef varsa once stop sayilir.
if dir != 0 and bar_index > entryBar
    hitSL = dir == 1 ? low <= sl : high >= sl
    hitT1 = dir == 1 ? high >= tp1 : low <= tp1
    hitT2 = dir == 1 ? high >= tp2 : low <= tp2
    remQ  = tp1Hit ? 1.0 - partQ : 1.0
    held  = bar_index - entryBar
    if hitSL
        closedR := (realized + remQ * (sl - entry) * dir - cost) / risk
        closedTxt := tp1Hit ? "Başa baş" : "Stop"
    else if hitT2
        r1p = tp1Hit ? realized : partQ * (tp1 - entry) * dir
        closedR := (r1p + (1.0 - partQ) * (tp2 - entry) * dir - cost) / risk
        closedTxt := "TP2"
    else
        if hitT1 and not tp1Hit
            tp1Hit := true
            realized := partQ * (tp1 - entry) * dir
            sl := entry
            status := "TP1 alındı, stop girişte"
        if tp1Hit and partQ >= 1.0
            closedR := (realized - cost) / risk
            closedTxt := "TP1"
        else if (not tp1Hit and held >= timeStop) or held >= timeStop * 3
            closedR := (realized + (tp1Hit ? 1.0 - partQ : 1.0) * (close - entry) * dir - cost) / risk
            closedTxt := "Zaman stopu"
    if not na(closedR)
        dir := 0

canSig   = na(lastSig) or bar_index - lastSig > cooldown
gate     = barstate.isconfirmed and canSig and not nearFunding and volMa > 0
longSig  = gate and longType > 0 and dir != 1 and longSc > shortSc
shortSig = gate and shortType > 0 and dir != -1 and shortSc > longSc

// Ters sinyal acik pozisyonu kapatir
if (longSig or shortSig) and dir != 0
    remQ2 = tp1Hit ? 1.0 - partQ : 1.0
    closedR := (realized + remQ2 * (close - entry) * dir - cost) / risk
    closedTxt := "Ters sinyal"

// === Gecmis performans (komisyon ve kayma dahil, R cinsinden) ===
// posType ve posScore burada henuz kapanan islemin degerleridir.
var int nTr = 0
var int nWin = 0
var float sumR = 0.0
var float sumR2 = 0.0
var float grossW = 0.0
var float grossL = 0.0
var float peakR = 0.0
var float maxDD = 0.0
var int nT = 0
var float sumT = 0.0
var float gwT = 0.0
var float glT = 0.0
var int nS = 0
var float sumS = 0.0
var float gwS = 0.0
var float glS = 0.0
var int nB1 = 0
var int nB2 = 0
var int nB3 = 0
var float sB1 = 0.0
var float sB2 = 0.0
var float sB3 = 0.0
if not na(closedR)
    nTr += 1
    sumR += closedR
    sumR2 += closedR * closedR
    if closedR > 0
        nWin += 1
        grossW += closedR
    else
        grossL -= closedR
    peakR := math.max(peakR, sumR)
    maxDD := math.max(maxDD, peakR - sumR)
    if posType == 1
        nT += 1
        sumT += closedR
        if closedR > 0
            gwT += closedR
        else
            glT -= closedR
    else
        nS += 1
        sumS += closedR
        if closedR > 0
            gwS += closedR
        else
            glS -= closedR
    if posScore >= 80
        nB3 += 1
        sB3 += closedR
    else if posScore >= 70
        nB2 += 1
        sB2 += closedR
    else
        nB1 += 1
        sB1 += closedR
    status := closedTxt + " (" + str.tostring(closedR, "#.##") + "R)"

// === Yeni pozisyon ===
if longSig or shortSig
    d = longSig ? 1 : -1
    typ = longSig ? longType : shortType
    sc = longSig ? longSc : shortSc
    dist = longSig ? (typ == 1 ? dTL : dSL) : (typ == 1 ? dTS : dSS)
    dir := d
    posType := typ
    posScore := sc
    entry := close
    sl := close - d * dist
    risk := dist
    tp1 := close + d * dist * tp1R
    tp2 := close + d * dist * tp2R
    cost := costPx
    realized := 0.0
    tp1Hit := false
    entryBar := bar_index
    lastSig := bar_index
    typTxt = typ == 1 ? "Trend devamı" : "Likidite süpürme"
    status := (longSig ? "LONG" : "SHORT") + " açık, " + typTxt
    col = longSig ? (typ == 1 ? color.green : color.teal) : (typ == 1 ? color.red : color.orange)
    tt = typTxt + "\nSkor: " + str.tostring(sc) + "\nGiriş: " + str.tostring(entry, format.mintick) + "\nStop: " + str.tostring(sl, format.mintick) + "\nTP1: " + str.tostring(tp1, format.mintick) + "\nTP2: " + str.tostring(tp2, format.mintick) + "\nMaliyet: " + str.tostring(cost / risk, "#.##") + "R" + "\nVR: " + str.tostring(vr, "#.00") + " | VPIN yüzdelik: " + str.tostring(vpinPr, "#")
    label.new(bar_index, close, (longSig ? "AL " : "SAT ") + str.tostring(sc), yloc = longSig ? yloc.belowbar : yloc.abovebar, style = longSig ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = size.small, tooltip = tt)
    msg = (longSig ? "AL " : "SAT ") + syminfo.ticker + " | " + typTxt + " | Skor " + str.tostring(sc) + " | Giriş " + str.tostring(entry, format.mintick) + " | Stop " + str.tostring(sl, format.mintick) + " | TP1 " + str.tostring(tp1, format.mintick) + " | TP2 " + str.tostring(tp2, format.mintick)
    alert(msg, alert.freq_once_per_bar_close)

// === Seviye cizimleri ===
act = showPos and dir != 0
plot(act ? entry : na, "Giriş", color.new(color.gray, 0), 1, plot.style_linebr)
plot(act ? sl : na, "Stop", color.new(color.red, 0), 2, plot.style_linebr)
plot(act ? tp1 : na, "TP1", color.new(color.lime, 30), 1, plot.style_linebr)
plot(act ? tp2 : na, "TP2", color.new(color.lime, 0), 2, plot.style_linebr)

// === Alarmlar ===
alertcondition(longSig, "VSP AL", "VSP: AL sinyali")
alertcondition(shortSig, "VSP SAT", "VSP: SAT sinyali")

// === Paneller ===
var table panel = table.new(position.top_right, 2, 13, bgcolor = color.new(color.black, 20), border_width = 1)
var table stats = table.new(position.bottom_right, 2, 10, bgcolor = color.new(color.black, 20), border_width = 1)

cell(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)

pfStr(float w, float l) => l > 0 ? str.tostring(w / l, "#.00") : "-"
bucketStr(int n, float s) => str.tostring(n) + ": " + str.tostring(s, "#.#") + "R"

cGood = color.lime
cBad = color.red
cMid = color.gray

if showPanel and barstate.islast
    regTxt = trendReg ? (upTrend ? "Trend yukarı" : dnTrend ? "Trend aşağı" : "Trend, yön karışık") : "Yatay / gürültülü"
    cell(panel, 0, "Rejim (ER " + str.tostring(er, "#.00") + ")", regTxt, trendReg ? (upTrend ? cGood : dnTrend ? cBad : cMid) : color.yellow)
    vrTxt = vrOk ? (vr > 1.1 ? "Momentum" : vr < 0.9 ? "Ters dönüş" : "Nötr") : "Veri yok"
    cell(panel, 1, "Eğilim (VR " + (vrOk ? str.tostring(vr, "#.00") : "-") + ")", vrTxt, cMid)
    cell(panel, 2, "Üst ZD (" + htf + ")", htfUp ? "Yukarı" : htfDn ? "Aşağı" : "Yatay", htfUp ? cGood : htfDn ? cBad : cMid)
    cell(panel, 3, "BTC", isBtc ? "Bu grafik" : btcOk ? (btcUp ? "Yukarı" : btcDn ? "Aşağı" : "Karışık") : "Veri yok", isBtc ? cMid : btcUp ? cGood : btcDn ? cBad : cMid)
    flowTxt = str.tostring(dRatio * 100, "#") + "% | VPIN %" + str.tostring(vpinPr, "#") + (toxic ? " toksik" : "")
    cell(panel, 4, "Akış (delta / VPIN)", flowTxt, toxic ? color.yellow : dRatio >= dMin ? cGood : dRatio <= -dMin ? cBad : cMid)
    cell(panel, 5, "OI değişimi", oiOk ? str.tostring(oiCh, "#.##") + "%" : "Veri yok", oiOk ? (oiCh > 0 ? cGood : cBad) : cMid)
    premTxt = premOk ? "z " + str.tostring(premZ, "#.0") + (longCrowd ? ", longlar kalabalık" : shortCrowd ? ", shortlar kalabalık" : ", normal") : "Veri yok"
    cell(panel, 6, "Prim (kalabalık)", premTxt, longCrowd or shortCrowd ? color.yellow : cMid)
    cell(panel, 7, "Hacim / kayma", str.tostring(rvol, "#.0") + "x | kayma x" + str.tostring(liqMult * qhMult, "#.0"), liqMult > 1.5 ? color.yellow : rvol >= rvolMin ? cGood : cMid)
    liveCostR = costPx / dTL
    cell(panel, 8, "Maliyet / risk", str.tostring(liveCostR, "#.00") + "R", liveCostR <= maxCostR ? cGood : cBad)
    cell(panel, 9, "Fonlama", nearFunding ? "Yakın, sinyal yok" : str.tostring(fundPeriod - minsSince) + " dk sonra", nearFunding ? color.yellow : cMid)
    cell(panel, 10, "Trend skoru L / S", str.tostring(tScoreL) + " / " + str.tostring(tScoreS), tScoreL >= minScore ? cGood : tScoreS >= minScore ? cBad : cMid)
    cell(panel, 11, "Durum", status, dir == 1 ? cGood : dir == -1 ? cBad : color.white)
    warnTxt = timeframe.period != "1" ? "1 dk grafiğe geçin" : volMa > 0 ? "Yok" : "Hacim verisi yok"
    cell(panel, 12, "Uyarı", warnTxt, warnTxt == "Yok" ? cMid : color.yellow)

// Guven: islem basina ortalama R'nin t-istatistigi. Kelly: kazanma orani ve kazanc/kayip oranindan risk payi.
if showStats and barstate.islast
    meanR = nTr > 0 ? sumR / nTr : 0.0
    varR = nTr > 1 ? (sumR2 - nTr * meanR * meanR) / (nTr - 1) : 0.0
    sdR = math.sqrt(math.max(varR, 0.0))
    tStat = nTr > 1 and sdR > 0 ? meanR / (sdR / math.sqrt(nTr)) : 0.0
    verdict = nTr < 30 ? "Az veri (<30 işlem)" : tStat >= 2 ? "Anlamlı kenar" : tStat >= 1 ? "Zayıf kanıt" : tStat > -1 ? "Kenar yok" : "Negatif kenar"
    vCol = nTr < 30 ? color.yellow : tStat >= 2 ? cGood : tStat >= 1 ? color.yellow : tStat > -1 ? cMid : cBad
    winTxt = nTr > 0 ? str.tostring(nWin * 100.0 / nTr, "#") + "%" : "-"
    nLoss = nTr - nWin
    avgW = nWin > 0 ? grossW / nWin : 0.0
    avgL = nLoss > 0 ? grossL / nLoss : 0.0
    wr = nTr > 0 ? nWin * 1.0 / nTr : 0.0
    kelly = avgW > 0 and avgL > 0 ? wr - (1 - wr) / (avgW / avgL) : 0.0
    riskPct = math.min(1.0, math.max(0.0, kelly / 2 * 100))
    kellyTxt = nTr < 30 ? "Az veri: en fazla %0,25" : kelly <= 0 ? "0 (kenar yok)" : "%" + str.tostring(riskPct, "#.##")
    cell(stats, 0, "PERFORMANS", "komisyon ve kayma dahil", color.white)
    cell(stats, 1, "İşlem / isabet", str.tostring(nTr) + " / " + winTxt, cMid)
    cell(stats, 2, "Net R / PF", str.tostring(sumR, "#.#") + "R / " + pfStr(grossW, grossL), sumR > 0 ? cGood : sumR < 0 ? cBad : cMid)
    cell(stats, 3, "Ortalama R / işlem", str.tostring(meanR, "#.###") + "R", meanR > 0 ? cGood : meanR < 0 ? cBad : cMid)
    cell(stats, 4, "En büyük düşüş", str.tostring(maxDD, "#.#") + "R", cMid)
    cell(stats, 5, "Güven (t " + str.tostring(tStat, "#.0") + ")", verdict, vCol)
    cell(stats, 6, "Önerilen risk (yarım Kelly)", kellyTxt, nTr >= 30 and kelly > 0 ? cGood : color.yellow)
    cell(stats, 7, "Trend devamı", str.tostring(nT) + " işlem | " + str.tostring(sumT, "#.#") + "R | PF " + pfStr(gwT, glT), sumT > 0 ? cGood : sumT < 0 ? cBad : cMid)
    cell(stats, 8, "Likidite süpürme", str.tostring(nS) + " işlem | " + str.tostring(sumS, "#.#") + "R | PF " + pfStr(gwS, glS), sumS > 0 ? cGood : sumS < 0 ? cBad : cMid)
    cell(stats, 9, "Skor <70 / 70-79 / 80+", bucketStr(nB1, sB1) + " | " + bucketStr(nB2, sB2) + " | " + bucketStr(nB3, sB3), cMid)
// VSP SONU - bu satiri goremiyorsaniz kod eksik kopyalanmistir
