//@version=6
// Vadeli Scalp Pusulasi (VSP) - v5.2.0 | 1 dakika piyasa gostergesi
// Gosterge AL/SAT, stop ya da pozisyon onerisi vermez: nereden alip satacaginiza ve stopunuza siz karar verirsiniz.
// Gosterge piyasayi anlatir:
//   1) Piyasa su an islem icin uygun mu (fonlama, asiri mum, likidite)?
//   2) Fiyat, komisyonu karsilayacak kadar hareket ediyor mu?
//   3) Son 15 dakikada sert, saldirgan bir akis oldu mu (kovalama uyarisi)?
//   4) Onumuzdeki dakikalarda fiyat tipik olarak ne kadar oynar?
// Dayanak: 22 Binance vadeli paritesi, 21 ay, ~20 milyon mum (arastirma/BULGULAR.md).
indicator("Vadeli Scalp Pusulası", shorttitle = "VSP", overlay = true, max_boxes_count = 5)

// === Girdiler ===
grpE = "Maliyet (hareket / maliyet hesabı için)"
entryMode = input.string("Limit (maker)", "Giriş emri tipiniz", options = ["Limit (maker)", "Piyasa (taker)"], group = grpE, display = display.none)
makerFee  = input.float(0.02, "Maker komisyonu % (tek yön)", step = 0.005, group = grpE, display = display.none)
takerFee  = input.float(0.05, "Taker komisyonu % (tek yön)", step = 0.005, group = grpE, display = display.none)
slipSide  = input.float(0.01, "Kayma % (tek yön, normal likidite)", step = 0.005, group = grpE, display = display.none)

grpP = "Piyasa koşulu"
fundHours = input.int(8, "Fonlama aralığı (saat)", options = [1, 2, 4, 8], group = grpP, display = display.none)
fundBlock = input.int(3, "Fonlama saatine ± dk uyarı", minval = 0, group = grpP, display = display.none)
spikeAtr  = input.float(4.0, "Aşırı mum sınırı (ATR x)", step = 0.5, group = grpP, display = display.none)
spikeWait = input.int(5, "Aşırı mumdan sonra uyarı süresi (mum)", minval = 1, group = grpP, display = display.none)
flowZ     = input.float(3.0, "Sert hareket eşiği (15 dk z)", step = 0.5, group = grpP, display = display.none)
flowImb   = input.float(0.15, "Akış dengesizliği eşiği", step = 0.05, group = grpP, display = display.none)
flowBars  = input.int(15, "Kovalama uyarısı süresi (mum)", minval = 1, group = grpP, display = display.none)
horizon   = input.int(15, "Beklenen hareket ufku (dk)", minval = 1, maxval = 240, group = grpP, display = display.none)
htf       = input.timeframe("15", "Bağlam için üst zaman dilimi", group = grpP, display = display.none)

grpV = "Görünüm"
showLevels = input.bool(true, "VWAP ve günlük seviyeler", group = grpV, display = display.none)
showBox    = input.bool(true, "Beklenen hareket kutusu (%80)", group = grpV, display = display.none)
showBg     = input.bool(true, "Kovalama uyarısında arka plan", group = grpV, display = display.none)
panelPos   = input.string("Sağ üst", "Panel konumu", options = ["Sağ üst", "Sağ alt", "Sol üst", "Sol alt"], group = grpV, display = display.none)

isLimit = entryMode == "Limit (maker)"

// === Hesaplar ===
atr = ta.atr(14)
[vwapV, vwapU, vwapL] = ta.vwap(hlc3, timeframe.change("D"), 2.0)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead = barmerge.lookahead_on)

// Asya seansi (00-08 UTC) yuksek/dusuk, 08:00'den sonra cizilir
newDay = timeframe.change("D")
inAsia = not na(time(timeframe.period, "0000-0800", "UTC"))
var float asiaHT = na
var float asiaLT = na
if newDay
    asiaHT := high
    asiaLT := low
else if inAsia
    asiaHT := math.max(nz(asiaHT, high), high)
    asiaLT := math.min(nz(asiaLT, low), low)
asiaHi = not inAsia ? asiaHT : na
asiaLo = not inAsia ? asiaLT : na

// Hacim ve likidite (Amihud: fiyat etkisi / dolar hacmi, kendi uzun vadeli seviyesine oranla)
volMa   = ta.sma(volume, 20)
r1      = math.log(close / close[1])
illiq   = volume > 0 ? math.abs(r1) / (volume * close) : 0.0
illiqS  = math.max(ta.sma(illiq, 20), 1e-15)
illiqB  = math.exp(ta.ema(math.log(illiqS), 1440))
liqMult = not na(illiqB) and illiqB > 0 ? math.max(0.5, math.min(3.0, illiqS / illiqB)) : 1.0
qhMult  = minute(time_close, "UTC") % 15 == 0 ? 1.5 : 1.0

// Akis: BVC tahmini delta (gercek taker deltasiyla korelasyon ~0,67) ve 15 dk hareketin z-skoru
dp      = close - close[1]
dpSd    = ta.stdev(dp, 100)
buyFrac = dpSd > 0 ? 1.0 / (1.0 + math.exp(-1.702 * dp / dpSd)) : 0.5
sVol    = volume * (2 * buyFrac - 1)
v15     = math.sum(volume, 15)
imb15   = v15 > 0 ? math.sum(sVol, 15) / v15 : 0.0
sd1     = ta.stdev(r1, 1440)
z15     = sd1 > 0 ? math.log(close / close[15]) / (sd1 * math.sqrt(15)) : 0.0
flowUp  = z15 >= flowZ and imb15 >= flowImb
flowDn  = z15 <= -flowZ and imb15 <= -flowImb

var int lastUp = na
var int lastDn = na
var int lastSpike = na
if flowUp
    lastUp := bar_index
if flowDn
    lastDn := bar_index
spike = (high - low) > spikeAtr * nz(atr[1], atr)
if spike
    lastSpike := bar_index
warnLong    = not na(lastUp) and bar_index - lastUp < flowBars
warnShort   = not na(lastDn) and bar_index - lastDn < flowBars
spikeActive = not na(lastSpike) and bar_index - lastSpike < spikeWait

// Fonlama penceresi (UTC)
hUtc        = hour(time, "UTC")
minsSince   = (hUtc % fundHours) * 60 + minute(time, "UTC")
fundPeriod  = fundHours * 60
nearFunding = fundBlock > 0 and (minsSince < fundBlock or minsSince >= fundPeriod - fundBlock)

// Beklenen hareket: 1 dk getirinin 30 mumluk EWMA varyansi (22 paritede kalibre; %50 dilim 0.61, %80 dilim 1.23)
ewVar = ta.ema(nz(r1 * r1), 30)
sigH  = math.sqrt(ewVar * horizon)
em50  = 0.61 * sigH
em80  = 1.23 * sigH

// Hareket / maliyet: ufuktaki tipik hareket (%50 dilim), gidis-donus maliyetinin kac kati
takerX   = takerFee + slipSide * liqMult * qhMult
entryX   = isLimit ? makerFee : takerX
costPct  = entryX + takerX
moveCost = costPct > 0 ? em50 * 100 / costPct : na

// Genel durum
wrongTf = timeframe.period != "1"
noVol   = not (volMa > 0)
redTxt  = wrongTf ? "1 dk grafiğe geçin" : noVol ? "Hacim verisi yok" : nearFunding ? "Fonlama saati" : spikeActive ? "Aşırı mum" : moveCost < 1 ? "Hareket maliyetten küçük" : ""
isRed   = redTxt != ""
yelTxt  = moveCost < 2 ? "Hareket maliyete yakın" : liqMult > 1.5 ? "Likidite ince" : warnLong and warnShort ? "İki yönde sert akış" : ""
isYel   = not isRed and yelTxt != ""

// === Cizimler ===
plot(showLevels ? vwapV : na, "VWAP", color.new(color.orange, 0), 2, display = display.pane)
plot(showLevels ? vwapU : na, "VWAP +2σ", color.new(color.orange, 70), 1, display = display.pane)
plot(showLevels ? vwapL : na, "VWAP -2σ", color.new(color.orange, 70), 1, display = display.pane)
plot(showLevels ? pdh : na, "Önceki gün yüksek", color.new(color.gray, 20), 1, plot.style_linebr, display = display.pane)
plot(showLevels ? pdl : na, "Önceki gün düşük", color.new(color.gray, 20), 1, plot.style_linebr, display = display.pane)
plot(showLevels ? asiaHi : na, "Asya yüksek", color.new(color.purple, 30), 1, plot.style_linebr, display = display.pane)
plot(showLevels ? asiaLo : na, "Asya düşük", color.new(color.purple, 30), 1, plot.style_linebr, display = display.pane)
bgcolor(showBg and (warnLong or warnShort) ? color.new(color.orange, 88) : na, title = "Kovalama uyarısı")

var box emBox = na
if showBox and barstate.islast
    box.delete(emBox)
    emBox := box.new(bar_index, close * math.exp(em80), bar_index + horizon, close * math.exp(-em80), border_color = color.new(color.blue, 50), bgcolor = color.new(color.blue, 90), text = "%80 aralık (" + str.tostring(horizon) + " dk)", text_color = color.new(color.blue, 20), text_size = size.tiny, text_valign = text.align_top)

// === Alarmlar ===
alertcondition(flowUp, "VSP: Sert alış akışı", "Sert alış akışı: LONG kovalamayın")
alertcondition(flowDn, "VSP: Sert satış akışı", "Sert satış akışı: SHORT kovalamayın")
alertcondition(isRed[1] and not isRed, "VSP: Koşullar düzeldi", "VSP: Piyasa koşulları uygun hale geldi")

// === Panel ===
pos = panelPos == "Sağ üst" ? position.top_right : panelPos == "Sağ alt" ? position.bottom_right : panelPos == "Sol üst" ? position.top_left : position.bottom_left
var table panel = table.new(pos, 2, 9, bgcolor = color.new(color.black, 15), border_width = 1)

cell(int r, string k, string v, color c) =>
    table.cell(panel, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)

if barstate.islast
    cGood = color.lime
    cBad = color.red
    cWarn = color.yellow
    cMid = color.gray
    stTxt = isRed ? "UYGUN DEĞİL: " + redTxt : isYel ? "DİKKAT: " + yelTxt : "Koşullar uygun"
    stCol = isRed ? cBad : isYel ? cWarn : cGood
    table.cell(panel, 0, 0, "DURUM", text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    table.cell(panel, 1, 0, stTxt, text_color = color.black, bgcolor = stCol, text_size = size.normal, text_halign = text.align_left)
    cell(1, "Hareket / maliyet (" + str.tostring(horizon) + " dk)", str.tostring(nz(moveCost), "0.0") + " kat (hareket %" + str.tostring(em50 * 100, "0.00") + ", maliyet %" + str.tostring(costPct, "0.00") + ")", nz(moveCost) >= 2 ? cGood : nz(moveCost) >= 1 ? cWarn : cBad)
    cell(2, "Beklenen hareket (" + str.tostring(horizon) + " dk)", "%50: ±%" + str.tostring(em50 * 100, "0.00") + " | %80: ±%" + str.tostring(em80 * 100, "0.00"), cMid)
    flowTxt = warnLong and warnShort ? "İki yönde sert akış" : warnLong ? "Sert alış: LONG kovalamayın" : warnShort ? "Sert satış: SHORT kovalamayın" : "Normal"
    cell(3, "Son 15 dk akış (delta " + str.tostring(imb15 * 100, "0") + "%, z " + str.tostring(z15, "0.0") + ")", flowTxt, warnLong or warnShort ? cWarn : cMid)
    cell(4, "Fonlama", nearFunding ? "Şimdi" : str.tostring(fundPeriod - minsSince) + " dk sonra", nearFunding ? cBad : cMid)
    cell(5, "Oynaklık (1 dk ATR)", "%" + str.tostring(atr / close * 100, "0.000") + (spikeActive ? " | aşırı mum" : " | normal"), spikeActive ? cBad : cMid)
    cell(6, "Likidite (kayma çarpanı)", (liqMult > 1.5 ? "İnce" : "Normal") + " (x" + str.tostring(liqMult * qhMult, "0.0") + ")", liqMult > 1.5 ? cWarn : cMid)
    ctxTxt = (htfClose > htfEma ? "Üst ZD yukarı" : "Üst ZD aşağı") + ", fiyat VWAP " + (close > vwapV ? "üstünde" : "altında")
    cell(7, "Bağlam (bilgi, sinyal değil)", ctxTxt, cMid)
    warnTxt = wrongTf ? "1 dk grafiğe geçin" : noVol ? "Hacim verisi yok" : "Yok"
    cell(8, "Uyarı", warnTxt, warnTxt == "Yok" ? cMid : cWarn)
// VSP SONU - bu satiri goremiyorsaniz kod eksik kopyalanmistir
