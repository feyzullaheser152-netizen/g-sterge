//@version=6
// Vadeli Scalp Pusulasi (VSP) - v5.0.0 | 1 dakika islem kokpiti
// Gosterge AL/SAT vermez: nereden alip satacaginiza siz karar verirsiniz. Gosterge karar icin bilgi verir:
//   1) Bu islem komisyonu cikarabilir mi?  2) Piyasa su an uygun mu?  3) Hangi yon kovalanmamali?
//   4) Kac birim acmaliyim, stop nerede?
// Tek kanitli etki: saldirgan akisla gelen 15 dk sert hareketten sonra fiyat 5-15 dk icinde hafifce geri doner.
indicator("Vadeli Scalp Pusulası", shorttitle = "VSP", overlay = true, max_lines_count = 10, max_labels_count = 10)

// === Girdiler ===
grpA = "Hesap ve risk"
balance  = input.float(1000, "Hesap bakiyesi (USDT)", minval = 1, group = grpA, display = display.none)
riskPct  = input.float(0.5, "İşlem başına risk %", minval = 0.05, maxval = 5, step = 0.05, group = grpA, display = display.none)
stopMode = input.string("Son mumların dibi/tepesi", "Stop yöntemi", options = ["Son mumların dibi/tepesi", "ATR katı"], group = grpA, display = display.none)
stopLook = input.int(5, "Dip/tepe için mum sayısı", minval = 1, group = grpA, display = display.none)
stopBuf  = input.float(0.2, "Stop tamponu (ATR x)", step = 0.1, group = grpA, display = display.none)
stopAtr  = input.float(1.5, "ATR katı stop (ATR x)", step = 0.1, group = grpA, display = display.none)
minStop  = input.float(0.6, "En dar stop (ATR x)", step = 0.1, group = grpA, display = display.none)

grpE = "Emir ve maliyet"
entryMode = input.string("Limit (maker)", "Giriş emri", options = ["Limit (maker)", "Piyasa (taker)"], group = grpE, display = display.none)
makerFee  = input.float(0.02, "Maker komisyonu % (tek yön)", step = 0.005, group = grpE, display = display.none)
takerFee  = input.float(0.05, "Taker komisyonu % (tek yön)", step = 0.005, group = grpE, display = display.none)
slipSide  = input.float(0.01, "Kayma % (tek yön, normal likidite)", step = 0.005, group = grpE, display = display.none)
maxCostR  = input.float(0.20, "Kabul edilebilir maliyet / risk (R)", step = 0.05, group = grpE, display = display.none)

grpP = "Piyasa koşulu"
fundHours = input.int(8, "Fonlama aralığı (saat)", options = [1, 2, 4, 8], group = grpP, display = display.none)
fundBlock = input.int(3, "Fonlama saatine ± dk bekle", minval = 0, group = grpP, display = display.none)
spikeAtr  = input.float(4.0, "Aşırı mum sınırı (ATR x)", step = 0.5, group = grpP, display = display.none)
spikeWait = input.int(5, "Aşırı mumdan sonra bekleme (mum)", minval = 0, group = grpP, display = display.none)
flowZ     = input.float(3.0, "Sert hareket eşiği (15 dk z)", step = 0.5, group = grpP, display = display.none)
flowImb   = input.float(0.15, "Akış dengesizliği eşiği", step = 0.05, group = grpP, display = display.none)
flowBars  = input.int(15, "Kovalama uyarısı süresi (mum)", minval = 1, group = grpP, display = display.none)
htf       = input.timeframe("15", "Bağlam için üst zaman dilimi", group = grpP, display = display.none)

grpV = "Görünüm"
showLevels = input.bool(true, "VWAP ve günlük seviyeler", group = grpV, display = display.none)
showStops  = input.bool(true, "Long / short stop çizgileri", group = grpV, display = display.none)
showBg     = input.bool(true, "Kovalama uyarısında arka plan", group = grpV, display = display.none)
panelPos   = input.string("Sağ üst", "Panel konumu", options = ["Sağ üst", "Sağ alt", "Sol üst", "Sol alt"], group = grpV, display = display.none)

isLimit = entryMode == "Limit (maker)"

// === Hesaplar ===
atr = ta.atr(14)
[vwapV, vwapU, vwapL] = ta.vwap(hlc3, timeframe.change("D"), 2.0)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)

// Asya seansi (00-08 UTC) yuksek/dusuk, 08:00'den sonra cizilir
newDay = timeframe.change("D")
inAsia = not na(time(timeframe.period, "0000-0800", "UTC"))
var float asiaHT = na
var float asiaLT = na
if newDay
    asiaHT := high
    asiaLT := low
else if inAsia
    asiaHT := math.max(nz(asiaHT, high), high)
    asiaLT := math.min(nz(asiaLT, low), low)
asiaHi = not inAsia ? asiaHT : na
asiaLo = not inAsia ? asiaLT : na
htfEma   = request.security(syminfo.tickerid, htf, ta.ema(close, 50)[1], lookahead = barmerge.lookahead_on)
htfClose = request.security(syminfo.tickerid, htf, close[1], lookahead = barmerge.lookahead_on)

// Hacim ve likidite (Amihud: fiyat etkisi / dolar hacmi, kendi uzun vadeli seviyesine oranla)
volMa   = ta.sma(volume, 20)
r1      = math.log(close / close[1])
illiq   = volume > 0 ? math.abs(r1) / (volume * close) : 0.0
illiqS  = math.max(ta.sma(illiq, 20), 1e-15)
illiqB  = math.exp(ta.ema(math.log(illiqS), 1440))
liqMult = not na(illiqB) and illiqB > 0 ? math.max(0.5, math.min(3.0, illiqS / illiqB)) : 1.0
qhMult  = minute(time_close, "UTC") % 15 == 0 ? 1.5 : 1.0

// Akis: BVC tahmini delta (gercek taker deltasiyla korelasyon ~0,67) ve 15 dk hareketin z-skoru
dp      = close - close[1]
dpSd    = ta.stdev(dp, 100)
buyFrac = dpSd > 0 ? 1.0 / (1.0 + math.exp(-1.702 * dp / dpSd)) : 0.5
sVol    = volume * (2 * buyFrac - 1)
v15     = math.sum(volume, 15)
imb15   = v15 > 0 ? math.sum(sVol, 15) / v15 : 0.0
sd1     = ta.stdev(r1, 1440)
z15     = sd1 > 0 ? math.log(close / close[15]) / (sd1 * math.sqrt(15)) : 0.0
flowUp  = z15 >= flowZ and imb15 >= flowImb
flowDn  = z15 <= -flowZ and imb15 <= -flowImb

var int lastUp = na
var int lastDn = na
var int lastSpike = na
if flowUp
    lastUp := bar_index
if flowDn
    lastDn := bar_index
spike = (high - low) > spikeAtr * nz(atr[1], atr)
if spike
    lastSpike := bar_index
warnLong    = not na(lastUp) and bar_index - lastUp < flowBars
warnShort   = not na(lastDn) and bar_index - lastDn < flowBars
spikeActive = not na(lastSpike) and bar_index - lastSpike < math.max(spikeWait, 1)

// Fonlama penceresi (UTC)
hUtc        = hour(time, "UTC")
minsSince   = (hUtc % fundHours) * 60 + minute(time, "UTC")
fundPeriod  = fundHours * 60
nearFunding = fundBlock > 0 and (minsSince < fundBlock or minsSince >= fundPeriod - fundBlock)

// Stoplar ve maliyet
stopL = stopMode == "ATR katı" ? close - stopAtr * atr : math.min(ta.lowest(low, stopLook) - stopBuf * atr, close - minStop * atr)
stopS = stopMode == "ATR katı" ? close + stopAtr * atr : math.max(ta.highest(high, stopLook) + stopBuf * atr, close + minStop * atr)
distL = close - stopL
distS = stopS - close
takerX = takerFee + slipSide * liqMult * qhMult
entryX = isLimit ? makerFee : takerX
costPx = close * (entryX + takerX) / 100
costRL = distL > 0 ? costPx / distL : na
costRS = distS > 0 ? costPx / distS : na
costMin = math.min(nz(costRL, 9), nz(costRS, 9))

// Pozisyon buyuklugu: stopta kaybedilecek tutar (fiyat farki + komisyon) = bakiye x risk %
riskAmt = balance * riskPct / 100
qtyL = riskAmt / (distL + costPx)
qtyS = riskAmt / (distS + costPx)
notL = qtyL * close
notS = qtyS * close

// Genel durum
wrongTf = timeframe.period != "1"
noVol   = not (volMa > 0)
redTxt  = wrongTf ? "1 dk grafiğe geçin" : noVol ? "Hacim verisi yok" : nearFunding ? "Fonlama saati" : spikeActive ? "Aşırı mum, bekleyin" : costMin > 2 * maxCostR ? "Maliyet çok yüksek" : ""
isRed   = redTxt != ""
yelTxt  = costMin > maxCostR ? "Maliyet yüksek" : liqMult > 1.5 ? "Likidite ince" : ""
isYel   = not isRed and yelTxt != ""

// === Cizimler ===
plot(showLevels ? vwapV : na, "VWAP", color.new(color.orange, 0), 2)
plot(showLevels ? vwapU : na, "VWAP +2σ", color.new(color.orange, 70), 1)
plot(showLevels ? vwapL : na, "VWAP -2σ", color.new(color.orange, 70), 1)
plot(showLevels ? pdh : na, "Önceki gün yüksek", color.new(color.gray, 20), 1, plot.style_linebr)
plot(showLevels ? pdl : na, "Önceki gün düşük", color.new(color.gray, 20), 1, plot.style_linebr)
plot(showLevels ? asiaHi : na, "Asya yüksek", color.new(color.purple, 30), 1, plot.style_linebr)
plot(showLevels ? asiaLo : na, "Asya düşük", color.new(color.purple, 30), 1, plot.style_linebr)
bgcolor(showBg and (warnLong or warnShort) ? color.new(color.orange, 88) : na, title = "Kovalama uyarısı")

var line lnL = na
var line lnS = na
var label lbL = na
var label lbS = na
if showStops and barstate.islast
    line.delete(lnL)
    line.delete(lnS)
    label.delete(lbL)
    label.delete(lbS)
    lnL := line.new(bar_index - 3, stopL, bar_index + 8, stopL, color = color.new(color.green, 0), style = line.style_dashed)
    lnS := line.new(bar_index - 3, stopS, bar_index + 8, stopS, color = color.new(color.red, 0), style = line.style_dashed)
    lbL := label.new(bar_index + 8, stopL, "Long stop", style = label.style_label_left, color = color.new(color.green, 70), textcolor = color.white, size = size.tiny)
    lbS := label.new(bar_index + 8, stopS, "Short stop", style = label.style_label_left, color = color.new(color.red, 70), textcolor = color.white, size = size.tiny)

// === Alarmlar ===
alertcondition(flowUp, "VSP: Sert alış akışı", "Sert alış akışı: LONG kovalamayın")
alertcondition(flowDn, "VSP: Sert satış akışı", "Sert satış akışı: SHORT kovalamayın")
alertcondition(isRed[1] and not isRed, "VSP: Koşullar düzeldi", "VSP: İşlem koşulları uygun hale geldi")

// === Panel ===
pos = panelPos == "Sağ üst" ? position.top_right : panelPos == "Sağ alt" ? position.bottom_right : panelPos == "Sol üst" ? position.top_left : position.bottom_left
var table panel = table.new(pos, 2, 12, bgcolor = color.new(color.black, 15), border_width = 1)

cell(int r, string k, string v, color c) =>
    table.cell(panel, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(panel, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_left)

fmtQty(float q) => q >= 100 ? str.tostring(q, "0") : q >= 1 ? str.tostring(q, "0.00") : str.tostring(q, "0.0000")

if barstate.islast
    cGood = color.lime
    cBad = color.red
    cWarn = color.yellow
    cMid = color.gray
    stTxt = isRed ? "İŞLEM AÇMAYIN: " + redTxt : isYel ? "DİKKAT: " + yelTxt : "Koşullar uygun"
    stCol = isRed ? cBad : isYel ? cWarn : cGood
    table.cell(panel, 0, 0, "DURUM", text_color = color.white, text_size = size.normal, text_halign = text.align_left)
    table.cell(panel, 1, 0, stTxt, text_color = color.black, bgcolor = stCol, text_size = size.normal, text_halign = text.align_left)
    cell(1, "Maliyet / risk (L / S)", str.tostring(nz(costRL), "0.00") + "R / " + str.tostring(nz(costRS), "0.00") + "R", costMin <= maxCostR ? cGood : costMin <= 2 * maxCostR ? cWarn : cBad)
    cell(2, "Fonlama", nearFunding ? "Şimdi, bekleyin" : str.tostring(fundPeriod - minsSince) + " dk sonra", nearFunding ? cBad : cMid)
    cell(3, "Oynaklık (1 dk ATR)", "%" + str.tostring(atr / close * 100, "0.000") + (spikeActive ? " | aşırı mum, bekleyin" : " | normal"), spikeActive ? cBad : cMid)
    cell(4, "Likidite (kayma çarpanı)", (liqMult > 1.5 ? "İnce" : "Normal") + " (x" + str.tostring(liqMult * qhMult, "0.0") + ")", liqMult > 1.5 ? cWarn : cMid)
    flowTxt = warnLong and warnShort ? "İki yönde sert akış, bekleyin" : warnLong ? "Sert alış: LONG kovalamayın" : warnShort ? "Sert satış: SHORT kovalamayın" : "Normal"
    cell(5, "Son 15 dk akış (delta " + str.tostring(imb15 * 100, "0") + "%, z " + str.tostring(z15, "0.0") + ")", flowTxt, warnLong or warnShort ? cWarn : cMid)
    ctxTxt = (htfClose > htfEma ? "Üst ZD yukarı" : "Üst ZD aşağı") + ", fiyat VWAP " + (close > vwapV ? "üstünde" : "altında")
    cell(6, "Bağlam (bilgi, sinyal değil)", ctxTxt, cMid)
    cell(7, "LONG: stop / miktar", str.tostring(stopL, format.mintick) + " / " + fmtQty(qtyL), color.white)
    cell(8, "LONG: büyüklük / kaldıraç", str.tostring(notL, "0") + " USDT / en az " + str.tostring(math.ceil(notL / balance)) + "x", color.white)
    cell(9, "SHORT: stop / miktar", str.tostring(stopS, format.mintick) + " / " + fmtQty(qtyS), color.white)
    cell(10, "SHORT: büyüklük / kaldıraç", str.tostring(notS, "0") + " USDT / en az " + str.tostring(math.ceil(notS / balance)) + "x", color.white)
    cell(11, "Stopta kayıp (komisyon dahil)", str.tostring(riskAmt, "0.00") + " USDT (%" + str.tostring(riskPct, "0.0#") + ")", cMid)
// VSP SONU - bu satiri goremiyorsaniz kod eksik kopyalanmistir
